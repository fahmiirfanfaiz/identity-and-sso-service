  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"{{role}}\"\n}"
            },
            "description": "Mendaftarkan user baru untuk testing lokal."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = (() => { try { return pm.response.json(); } catch(e) { return null; } })();",
                  "pm.test('Response status is 201', function () { pm.expect(pm.response.code).to.eql(201); });",
                  "if (json && json.data && json.data.user && json.data.user.id) {",
                  "  pm.environment.set('userId', json.data.user.id);",
                  "  if (!pm.environment.get('projectCompletionTalentId')) { pm.environment.set('projectCompletionTalentId', json.data.user.id); }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Login user dan simpan accessToken / refreshToken ke environment."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = (() => { try { return pm.response.json(); } catch(e) { return null; } })();",
                  "pm.test('Response status is 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (json && json.data) {",
                  "  // support multiple possible response shapes: { data.accessToken } or { data.tokens.accessToken }",
                  "  const access = (json.data.tokens && json.data.tokens.accessToken) || json.data.accessToken || json.accessToken || '';",
                  "  const refresh = (json.data.tokens && json.data.tokens.refreshToken) || json.data.refreshToken || json.refreshToken || '';",
                  "  const uid = (json.data.user && json.data.user.id) || json.data.userId || json.userId || '';",
                  "  if (access) pm.environment.set('accessToken', access);",
                  "  if (refresh) pm.environment.set('refreshToken', refresh);",
                  "  if (uid) pm.environment.set('userId', uid);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "google"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{googleIdToken}}\"\n}"
            },
            "description": "Login menggunakan Google ID token."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = (() => { try { return pm.response.json(); } catch(e) { return null; } })();",
                  "pm.test('Response status is 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (json && json.data) {",
                  "  const access = json.data.accessToken || '';",
                  "  const refresh = json.data.refreshToken || '';",
                  "  const uid = json.data.user && json.data.user.id ? json.data.user.id : '';",
                  "  if (access) pm.environment.set('accessToken', access);",
                  "  if (refresh) pm.environment.set('refreshToken', refresh);",
                  "  if (uid) {",
                  "    pm.environment.set('userId', uid);",
                  "    if (!pm.environment.get('projectCompletionTalentId')) { pm.environment.set('projectCompletionTalentId', uid); }",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "Tukar refresh token menjadi access token baru."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = (() => { try { return pm.response.json(); } catch(e) { return null; } })();",
                  "pm.test('Response status is 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (json && json.data && json.data.accessToken) {",
                  "  pm.environment.set('accessToken', json.data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "Logout user dan hapus refresh token."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('accessToken');",
                  "pm.environment.unset('refreshToken');",
                  "pm.test('Logout response status is 200', function () { pm.expect(pm.response.code).to.eql(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reference Data",
      "item": [
        {
          "name": "Get Skill Options",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/skills/options",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "skills", "options"]
            },
            "description": "Mengambil daftar skill dan sub-skill untuk validasi form."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = (() => { try { return pm.response.json(); } catch(e) { return null; } })();",
                  "pm.test('Skill Options - status 200', () => pm.expect(pm.response.code).to.eql(200));",
                  "pm.test('Skill Options - data exists', () => pm.expect(json && json.data).to.exist);",
                  "pm.test('Skill Options - skills array exists', () => pm.expect(Array.isArray(json.data.skills)).to.be.true);",
                  "pm.test('Skill Options - subSkills array exists', () => pm.expect(Array.isArray(json.data.subSkills)).to.be.true);",
                  "if (json && json.data && json.data.skills && json.data.skills.length > 0) { pm.environment.set('defaultSkill', json.data.skills[0]); }",
                  "if (json && json.data && json.data.subSkills && json.data.subSkills.length > 0) { pm.environment.set('defaultSubSkill', json.data.subSkills[0]); }"
                ]
              }
            }
          ]
        }
      ]
