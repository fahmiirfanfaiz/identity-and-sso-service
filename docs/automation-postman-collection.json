{
  "info": {
    "name": "Identity & SSO - API Collection",
    "description": "Postman collection untuk testing endpoint Identity & SSO Service berdasarkan docs/openapi.yml.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
