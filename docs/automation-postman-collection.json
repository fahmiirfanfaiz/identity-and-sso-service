                  "const json = (() => { try { return pm.response.json(); } catch(e) { return null; } })();",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Update Profile - status 200', () => pm.expect(pm.response.code).to.eql(200));",
                  "  pm.test('Update Profile - returned user id', () => pm.expect(json && json.data && json.data.user && json.data.user.id).to.exist);",
                  "} else if (pm.response.code === 401) {",
